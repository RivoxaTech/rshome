{
  "name": "rshome",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:webpack": "next dev --webpack",
    "build": "next build",
    "build:standalone": "node scripts/build-standalone.mjs",
    "start:standalone": "node .next/standalone/server.js",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:migrate:test": "tsx scripts/migrate.ts --test",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset:orders": "tsx scripts/seed-demo-orders.ts reset",
    "db:seed:orders": "tsx scripts/seed-demo-orders.ts seed",
    "db:reset:wholesale": "tsx scripts/seed-demo-wholesale.ts reset",
    "db:seed:wholesale": "tsx scripts/seed-demo-wholesale.ts seed",
    "db:reset:dashboard": "tsx scripts/seed-demo-dashboard.ts reset",
    "db:seed:dashboard": "tsx scripts/seed-demo-dashboard.ts seed",
    "db:reset:products": "tsx scripts/seed-demo-products.ts reset",
    "db:seed:products": "tsx scripts/seed-demo-products.ts seed",
    "db:reset:discounts": "tsx scripts/seed-demo-promotions.ts reset",
    "db:seed:discounts": "tsx scripts/seed-demo-promotions.ts seed"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "drizzle-orm": "^0.45.3",
    "mysql2": "^3.24.4",
    "next": "16.3.6",
    "nodemailer": "^10.0.13",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.4",
    "web-push": "^3.6.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.19.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "dotenv": "^18.0.4",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "jsdom": "^30.1.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.2"
  }
}
