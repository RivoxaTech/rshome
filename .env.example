DATABASE_URL=mysql://user:password@127.0.0.1:3306/rs_home
SESSION_SECRET=change-me-to-32-or-more-random-characters
UPLOAD_DIR=/absolute/path/outside/the/app/folder/rshome-uploads
APP_URL=http://localhost:3000
ALLOWED_ORIGINS=

# Integration tests only (npm test): a separate database whose name ends in _test.
# `npm run db:migrate:test` creates and migrates it. Never point this at the real database.
TEST_DATABASE_URL=mysql://user:password@127.0.0.1:3306/rs_home_test

SEED_DEVELOPER_EMAIL=dev@example.com
SEED_DEVELOPER_PASSWORD=change-me
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me

# S21: web-push (optional in development; required in production — docs/ARCHITECTURE.md §6).
# The production private key must never change once devices have subscribed with the matching
# public key, or every existing subscription breaks.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# S21: SMTP (optional in development — a missing config just logs the email instead of sending;
# required in production).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
